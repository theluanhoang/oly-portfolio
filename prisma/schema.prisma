// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id           String   @id @default(cuid())
  slug         String   @unique
  heroImage    String
  gallery      String[] @default([])
  displayOrder   Int      @default(0)
  categoryId   String?
  subCategoryId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategory  SubCategory?  @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  translations ProjectTranslation[]

  relatedFrom ProjectRelation[] @relation("RelatedFrom")
  relatedTo   ProjectRelation[] @relation("RelatedTo")

  @@map("projects")
}

model ProjectRelation {
  id                    String   @id @default(cuid())
  projectId             String
  relatedProjectId      String
  displayOrder          Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project               Project  @relation("RelatedFrom", fields: [projectId], references: [id], onDelete: Cascade)
  relatedProject        Project  @relation("RelatedTo", fields: [relatedProjectId], references: [id], onDelete: Cascade)

  @@unique([projectId, relatedProjectId])
  @@index([projectId])
  @@index([relatedProjectId])
  @@map("project_relations")
}

model ProjectTranslation {
  id        String   @id @default(cuid())
  projectId String
  locale    String   // 'en' hoặc 'vi'
  
  title     String
  location  String
  area      String
  year      String
  content   String   @default("")
  
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([projectId, locale])
  @@index([projectId])
  @@index([locale])
  @@map("project_translations")
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations CategoryTranslation[]
  subCategories SubCategory[]
  projects     Project[]

  @@map("categories")
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  locale     String   // 'en' hoặc 'vi'
  
  name       String
  
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([categoryId, locale])
  @@index([categoryId])
  @@index([locale])
  @@map("category_translations")
}

model SubCategory {
  id          String   @id @default(cuid())
  categoryId  String
  slug        String
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations SubCategoryTranslation[]
  projects    Project[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("sub_categories")
}

model SubCategoryTranslation {
  id            String      @id @default(cuid())
  subCategoryId String
  locale        String      // 'en' hoặc 'vi'
  
  name          String
  
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@unique([subCategoryId, locale])
  @@index([subCategoryId])
  @@index([locale])
  @@map("sub_category_translations")
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  categoryId   String?
  materialId   String?
  year         String
  thumbnail    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  material     ProductMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  translations ProductTranslation[]

  @@map("products")
}

model ProductTranslation {
  id        String   @id @default(cuid())
  productId String
  locale    String   // 'en' hoặc 'vi'
  
  title     String
  descriptions String[] @default([])
  content   String   @default("")
  
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([productId, locale])
  @@index([productId])
  @@index([locale])
  @@map("product_translations")
}

model User {
  id               String    @id @default(cuid())
  username         String    @unique
  email            String    @unique
  password         String
  role             String    @default("admin")
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("users")
}

model ProductCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations ProductCategoryTranslation[]
  products     Product[]

  @@map("product_categories")
}

model ProductCategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  locale     String   // 'en' hoặc 'vi'
  
  name       String
  
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([categoryId, locale])
  @@index([categoryId])
  @@index([locale])
  @@map("product_category_translations")
}

model ProductMaterial {
  id          String   @id @default(cuid())
  slug        String   @unique
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations ProductMaterialTranslation[]
  products     Product[]

  @@map("product_materials")
}

model ProductMaterialTranslation {
  id         String   @id @default(cuid())
  materialId String
  locale     String   // 'en' hoặc 'vi'
  
  name       String
  
  material   ProductMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([materialId, locale])
  @@index([materialId])
  @@index([locale])
  @@map("product_material_translations")
}

model Translation {
  id        String   @id @default(cuid())
  key       String
  locale    String
  value     String   @db.Text
  namespace String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, locale, namespace])
  @@index([locale])
  @@index([namespace])
  @@map("translations")
}
