// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id           String   @id @default(cuid())
  slug         String   @unique
  heroImage    String
  gallery      String[] @default([])
  // New (storage-agnostic): reference images via MediaAsset IDs.
  // Kept alongside legacy URL fields (heroImage, gallery) for backward compatibility + data migration.
  heroImageAssetId String?
  galleryAssetIds  String[] @default([])
  displayOrder   Int      @default(0)
  categoryId   String?
  subCategoryId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategory  SubCategory?  @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  translations ProjectTranslation[]

  @@map("projects")
}

model ProjectTranslation {
  id        String   @id @default(cuid())
  projectId String
  locale    String   // 'en' hoặc 'vi'
  
  title     String
  location  String
  area      String
  year      String
  content   String   @default("")
  
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([projectId, locale])
  @@index([projectId])
  @@index([locale])
  @@map("project_translations")
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations CategoryTranslation[]
  subCategories SubCategory[]
  projects     Project[]

  @@map("categories")
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  locale     String   // 'en' hoặc 'vi'
  
  name       String
  
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([categoryId, locale])
  @@index([categoryId])
  @@index([locale])
  @@map("category_translations")
}

model SubCategory {
  id          String   @id @default(cuid())
  categoryId  String
  slug        String
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations SubCategoryTranslation[]
  projects    Project[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@map("sub_categories")
}

model SubCategoryTranslation {
  id            String      @id @default(cuid())
  subCategoryId String
  locale        String      // 'en' hoặc 'vi'
  
  name          String
  
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@unique([subCategoryId, locale])
  @@index([subCategoryId])
  @@index([locale])
  @@map("sub_category_translations")
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  category     String
  material     String
  year         String
  thumbnail    String
  // New (storage-agnostic): reference image via MediaAsset ID.
  // Kept alongside legacy URL field (thumbnail) for backward compatibility + data migration.
  thumbnailAssetId String?
  descriptions String[] @default([])
  content      String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("products")
}

model MediaAsset {
  id        String   @id @default(cuid())
  provider  String   // e.g. "cloudinary" | "local"
  key       String   // cloudinary: public_id; local: storage key/path
  version   String?  // cloudinary version or local version/hash

  mimeType  String?
  width     Int?
  height    Int?
  bytes     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([key])
  @@map("media_assets")
}

model User {
  id               String    @id @default(cuid())
  username         String    @unique
  email            String    @unique
  password         String
  role             String    @default("admin")
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("users")
}

model Translation {
  id        String   @id @default(cuid())
  key       String
  locale    String
  value     String   @db.Text
  namespace String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, locale, namespace])
  @@index([locale])
  @@index([namespace])
  @@map("translations")
}
