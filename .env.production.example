# =========================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO MÔI TRƯỜNG PRODUCTION (EC2 / VPS / HOSTINGER)
# =========================================================================
# File này chứa cấu hình mẫu dành riêng cho việc deploy production.
# KHÔNG ĐƯỢC COMMIT FILE `.env` THỰC TẾ LÊN GIT.
# =========================================================================

# -------------------------------------------------------------------------
# 1. Cấu hình Cơ sở dữ liệu (PostgreSQL)
# -------------------------------------------------------------------------
# Lưu ý quan trọng: Hãy đổi mật khẩu database an toàn
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_production_password_here
POSTGRES_DB=oly_portfolio
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# DATABASE_URL cho Prisma kết nối trong môi trường Docker Production
DATABASE_URL="postgresql://postgres:your_secure_production_password_here@postgres:5432/oly_portfolio?schema=public"

# -------------------------------------------------------------------------
# 2. Cấu hình Ứng dụng Next.js & Docker / Nginx
# -------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_HTTPS=true
PORT=3000

# Các biến phục vụ cho docker-compose.prod.yml
APP_PORT=3000
NGINX_PORT=80
APP_IMAGE=oly-studio-portfolio:latest

# -------------------------------------------------------------------------
# 3. Cấu hình Xác thực (NextAuth.js)
# -------------------------------------------------------------------------
# NEXTAUTH_SECRET: BẮT BUỘC tạo một chuỗi ngẫu nhiên có độ bảo mật cao:
# Dùng command: openssl rand -base64 32
NEXTAUTH_SECRET=your_secure_production_nextauth_secret
NEXTAUTH_URL=https://olystudio.vn
NEXT_PUBLIC_APP_URL=https://olystudio.vn

# -------------------------------------------------------------------------
# 4. Cấu hình Tài khoản Admin Khởi tạo
# -------------------------------------------------------------------------
# Tài khoản admin hệ thống được tạo tự động khi khởi chạy lần đầu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_EMAIL=admin@olystudio.vn

# -------------------------------------------------------------------------
# 5. Cấu hình Gửi Email (Brevo API hoặc SMTP)
# -------------------------------------------------------------------------
# 5.1. Sử dụng Brevo API (Khuyên dùng cho production)
BREVO_API_KEY=your_production_brevo_api_key_here

# 5.2. Sử dụng SMTP Server (Nodemailer - Dùng nếu không có/không dùng Brevo API Key)
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# 5.3. Cấu hình Người gửi & Người nhận liên hệ
FROM_EMAIL=contact@olystudio.vn
FROM_NAME="Oly Studio"
# Email nhận thông báo khi khách gửi Contact Form
CONTACT_EMAIL=info@olystudio.vn

# -------------------------------------------------------------------------
# 6. Cấu hình SEO & Địa chỉ trang Web chính thức
# -------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://olystudio.vn
NEXT_PUBLIC_DEFAULT_OG_IMAGE=/assets/og-default.png

# -------------------------------------------------------------------------
# 7. Cấu hình pgAdmin (Quản lý Database trực quan - Tùy chọn trong docker-compose.prod.yml)
# -------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@olystudio.vn
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password_here
PGADMIN_PORT=8080
