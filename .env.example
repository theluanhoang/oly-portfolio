# =========================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO CẢNH QUAN PHÁT TRIỂN (DEVELOPMENT / LOCAL)
# =========================================================================
# File này chứa các mẫu biến môi trường cần thiết để chạy dự án ở môi trường phát triển.
# Copy file này thành file `.env` hoặc `.env.local` trước khi khởi động ứng dụng:
# cp .env.example .env
# =========================================================================

# -------------------------------------------------------------------------
# 1. Cấu hình Cơ sở dữ liệu (PostgreSQL)
# -------------------------------------------------------------------------
# Lưu ý: Khi chạy ứng dụng local ngoài Docker: dùng POSTGRES_HOST=localhost
#        Khi chạy ứng dụng trong Docker: dùng POSTGRES_HOST=postgres (tên service trong docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=oly_portfolio
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# DATABASE_URL được Prisma sử dụng để kết nối tới database
# URL kết nối khi chạy local ngoài Docker:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oly_portfolio?schema=public"

# URL kết nối khi chạy bằng Docker Compose:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/oly_portfolio?schema=public"

# -------------------------------------------------------------------------
# 2. Cấu hình Ứng dụng Next.js
# -------------------------------------------------------------------------
PORT=3000
APP_PORT=3000
NODE_ENV=development
NEXT_PUBLIC_HTTPS=false

# -------------------------------------------------------------------------
# 3. Cấu hình Xác thực (NextAuth.js)
# -------------------------------------------------------------------------
# NEXTAUTH_SECRET: Khóa bí mật dùng để mã hóa session JWT
# Có thể tạo nhanh bằng command: openssl rand -base64 32
NEXTAUTH_SECRET=development_secret_key_please_change_in_production
NEXTAUTH_URL=http://localhost:3000

# -------------------------------------------------------------------------
# 4. Cấu hình Tài khoản Admin Khởi tạo
# -------------------------------------------------------------------------
# Tài khoản này sẽ tự động được tạo khi hệ thống khởi chạy nếu chưa tồn tại
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@oly-studio.com

# -------------------------------------------------------------------------
# 5. Cấu hình Gửi Email (Brevo API hoặc SMTP)
# -------------------------------------------------------------------------
# 5.1. Sử dụng Brevo API (Ưu tiên nếu có API Key)
BREVO_API_KEY=

# 5.2. Sử dụng SMTP Server (Nodemailer - Dùng nếu không cấu hình Brevo API Key)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false

# 5.3. Cấu hình Người gửi & Người nhận liên hệ
FROM_EMAIL=noreply@olystudio.vn
FROM_NAME="Oly Studio"
# Email nhận thông tin khi khách hàng gửi form liên hệ (Contact Form)
CONTACT_EMAIL=info@olystudio.vn

# -------------------------------------------------------------------------
# 6. Cấu hình SEO & Địa chỉ trang Web
# -------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_OG_IMAGE=/assets/og-default.png

# -------------------------------------------------------------------------
# 7. Cấu hình Chạy Kiểm thử (Tests)
# -------------------------------------------------------------------------
TEST_URL=http://localhost:3000
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_PASSWORD=admin123
